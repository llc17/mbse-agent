# Publish only the V12 implementation and its required code resources.
/*
!/.gitignore
!/.gitattributes
!/requirements.txt
!/v12.cmd

!/src/
/src/**
!/src/**/
!/src/**/*.py
!/src/**/*.mo
!/src/**/*.sysml
!/src/asym2/acceptance.json

!/tests/
/tests/**
!/tests/**/
!/tests/**/*.py
!/tests/fixtures/agent_reliability_original300.json

!/configs/
/configs/**
!/configs/case_runtime.json
!/configs/case_sources.json

# Local state, credentials, generated output, and project documents stay local.
.env*
__pycache__/
*.pyc
*.pyo
*.md
*.docx
*.pdf
/runs/
/results/
/case-history/
/sixwheel_fix/
/V12_old/
/任务规划/
/6轮上下楼仿真/
